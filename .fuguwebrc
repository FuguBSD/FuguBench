# The website, built by fuguweb(1).

site = FuguBench

nav "index.html" {
	label = Home
}

nav "manuals.html" {
	label = Manuals
}

page "index.html" {
	title = Home
	body  = index.body.html
}

page "manuals.html" {
	title = Manuals
	index = yes
}

page "404.html" {
	title    = Not found
	body     = 404.body.html
	unlinked = yes
}

manuals "Commands" {
	dir    = man/fugubench
	anchor = commands
}

modules "Modules" {
	dir    = lib/App/FuguBench
	anchor = modules
}
