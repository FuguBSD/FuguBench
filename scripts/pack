# pack: build the one-file program of this repository (DIST-PACK).
#
# usage: pack [--version X.Y] [--out DIR]
#
# The script runs scripts/dist with the same values first, and it
# packs the tarball that the build writes (DIST-PACK-7). mk/local.mk
# sets DIST, so make dist runs this script in place of scripts/dist.
#
# scripts/dist removes its staged tree, so the script extracts the
# tarball into a temporary directory and reads the stamped modules
# there. The stamp carries the version into the pack, and
# `fugubench version` prints it.
#
# The Fugu snapshot is the installed Fugu that deps/<OS>.txt names
# (DIST-PACK-6). The script loads each module of the list below and
# copies the file that %INC names. The list is explicit, because a
# trace of one run follows one verb and misses the rest
# (DIST-PACK-2).
#
# The script uses core modules alone, and it prints nothing on
# success.

use v5.34;
use warnings;
use experimental 'signatures';
no feature qw(indirect multidimensional bareword_filehandles);

use File::Find   ();
use File::Path   qw(make_path);
use File::Spec   ();
use File::Temp   ();
use Getopt::Long qw(GetOptions);

# The Fugu modules of the pack: the modules that CLI-FUGU-1 names,
# and the closure of those modules over their own use lines. Fugu
# itself holds no code, and it carries the version of the library.
# t/fugubench/pack.t computes the closure from the sources and holds
# the pack to it.
my @FUGU = qw(
    Fugu
    Fugu::CLI
    Fugu::Curl
    Fugu::Ed25519
    Fugu::File
    Fugu::Log
    Fugu::Process
    Fugu::Sandbox
    Fugu::Signer
    Fugu::Signify
);

# The heredoc terminator of a module body. Every packed line carries
# two leading spaces, so no line of a source can end a heredoc.
use constant MARK => 'FUGUBENCH_PACK';

my $version;
my $out = 'build';

GetOptions(
	'version=s' => \$version,
	'out=s'     => \$out,
) or die "usage: pack [--version X.Y] [--out DIR]\n";

# An empty value counts as absent, as in scripts/dist. The dist
# target of mk/perl.mk always passes the flag.
undef $version if defined $version && $version eq '';

-f 'scripts/dist'
    or die "pack: run me at the repository root\n";

# _read($path):
#	The whole text of one file.
sub _read ($path)
{
	open my $fh, '<', $path or die "pack: read $path: $!\n";
	local $/ = undef;
	my $text = <$fh>;
	close $fh;

	return $text;
}

# _build($version, $out):
#	Run scripts/dist with the same values, and return the path of
#	the tarball that it reports. The perl of this process runs the
#	build, so one interpreter builds both artifacts.
sub _build ( $version, $out )
{
	my @cmd = (
		$^X,     'scripts/dist', '--version', $version // q{},
		'--out', $out
	);

	open my $fh, '-|', @cmd or die "pack: cannot run scripts/dist: $!\n";
	my @lines = <$fh>;
	close $fh or die 'pack: scripts/dist exited ' . ( $? >> 8 ) . "\n";

	my ($tarball) = map { /^Built (.+)$/ ? $1 : () } @lines;
	defined $tarball
	    or die "pack: scripts/dist named no tarball\n";

	return $tarball;
}

# _extract($tarball, $dir):
#	Extract the tarball into $dir, and return the staged tree. The
#	tarball holds one directory, and its name is the name of the
#	tarball without the suffix.
sub _extract ( $tarball, $dir )
{
	my $status = system 'tar', '-xzf', $tarball, '-C', $dir;
	$status == 0
	    or die 'pack: tar exited ' . ( $status >> 8 ) . "\n";

	my ( undef, undef, $base ) = File::Spec->splitpath($tarball);
	$base =~ s/\.tar\.gz\z//
	    or die "pack: '$tarball' is no .tar.gz path\n";

	my $stage = File::Spec->catdir( $dir, $base );
	-d $stage or die "pack: the tarball holds no $base directory\n";

	return $stage;
}

# _app_modules($stage):
#	The modules of the program, from the staged tree. The key of
#	each one is its require name, as %INC holds it. scripts/dist
#	stamped the version into every package there.
sub _app_modules ($stage)
{
	my $lib = File::Spec->catdir( $stage, 'lib' );

	my %source;
	File::Find::find(
		sub {
			return unless -f $_ && /\.pm\z/;
			my $name =
			    File::Spec->abs2rel( $File::Find::name, $lib );
			$source{$name} = _read($File::Find::name);
		},
		$lib
	);

	%source or die "pack: the tarball holds no module\n";

	return %source;
}

# _fugu_modules():
#	The Fugu snapshot. The script loads each module of @FUGU and
#	copies the file that %INC names, so the pack carries the
#	installed release and its stamped $VERSION.
sub _fugu_modules ()
{
	my %source;
	for my $module (@FUGU) {
		my $name = ( $module =~ s{::}{/}gr ) . '.pm';
		eval { require $name; 1 }
		    or die "pack: cannot load $module: $@";
		my $path = $INC{$name}
		    or die "pack: no file for $module\n";
		$source{$name} = _read($path);
	}

	return %source;
}

# _program($stage):
#	The text of bin/fugubench, without the lines that a checkout
#	needs. The shebang of the pack replaces the shebang of the
#	file. The FindBin and lib lines put lib/ of a checkout in
#	front of the pack, so a packed file beside such a tree would
#	load the modules of the tree and report its version. The pack
#	carries every module of the program, so it needs neither line.
sub _program ($stage)
{
	my $text = _read( File::Spec->catfile( $stage, 'bin', 'fugubench' ) );

	my @lines = split /^/, $text;
	shift @lines if @lines && $lines[0] =~ m{\A\#!};

	return join q{}, grep { !m{\A\s*use\s+(?:FindBin|lib)\b} } @lines;
}

# _pack(\%source, $program):
#	The text of the packed file. A BEGIN block holds the source of
#	every module in a hash, and an @INC hook serves it. The text
#	of the program follows.
#
#	Every packed line carries two leading spaces, so no line of a
#	source ends a heredoc. The block strips them back before it
#	installs the hook.
#
#	The modules sort by name, and no timestamp and no path of the
#	build host enters the text, so one tree gives one byte
#	sequence (DIST-PACK-4).
#
#	The BEGIN block runs before the version pragma of the program,
#	so its code holds no signature and no feature of a later perl.
sub _pack ( $source, $program )
{
	my $mark = MARK;
	my $text = <<"HEAD";
#!/usr/bin/env perl
# The packed program of FuguBench. scripts/pack writes it from a
# release tarball and the installed Fugu, and no hand edits it.

BEGIN {
my %source;

HEAD

	for my $name ( sort keys %$source ) {
		my $body = $source->{$name};
		$body .= "\n" unless substr( $body, -1 ) eq "\n";
		$body =~ s/^/  /mg;
		$text .= "\$source{'$name'} = <<'$mark';\n$body$mark\n\n";
	}

	$text .= <<'HOOK';
s/^  //mg for values %source;

unshift @INC, sub {
	my $body = $source{ $_[1] };
	return unless defined $body;
	open my $fh, '<', \$body or return;
	return $fh;
};
}

HOOK

	return $text . $program;
}

my $tarball = _build( $version, $out );
my $dir     = File::Temp->newdir(
	TEMPLATE => 'fugubench-pack-XXXXXXXX',
	TMPDIR   => 1
);
my $stage = _extract( $tarball, "$dir" );

my %source = ( _app_modules($stage), _fugu_modules() );
my $text   = _pack( \%source, _program($stage) );

make_path($out);
my $packed = File::Spec->catfile( $out, 'fugubench' );
open my $fh, '>', $packed or die "pack: write $packed: $!\n";
print {$fh} $text;
close $fh or die "pack: close $packed: $!\n";
chmod 0755, $packed or die "pack: chmod $packed: $!\n";
